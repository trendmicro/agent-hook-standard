{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trendmicro.github.io/agent-hook-standard/schemas/0.1/hook-event.schema.json",
  "title": "Agent Hook 0.1 Request",
  "description": "A Claude Code-derived, security-telemetry request for an Agent Hook 0.1 event.",
  "$ref": "#/$defs/HookRequest",
  "$defs": {
    "Uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "Timestamp": {
      "type": "string",
      "description": "An RFC 3339 timestamp normalized to UTC (Z).",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "TraceContext": {
      "type": "object",
      "properties": {
        "trace_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "span_id": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "traceparent": { "type": "string", "pattern": "^[0-9a-f]{2}-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$" }
      },
      "required": ["trace_id", "span_id"],
      "additionalProperties": false
    },
    "Extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(?:[a-z][a-z0-9-]*\\.)+[a-z][a-z0-9-]*$"
      },
      "additionalProperties": true
    },
    "CoreEventName": {
      "enum": [
        "SessionStart",
        "UserPromptSubmit",
        "BeforeModelRequest",
        "AfterModelResponse",
        "PreToolUse",
        "PermissionRequest",
        "PermissionDenied",
        "PostToolUse",
        "PostToolUseFailure",
        "SubagentStart",
        "SubagentStop",
        "Stop",
        "SessionEnd"
      ]
    },
    "VendorEventName": {
      "type": "string",
      "pattern": "^x-[a-z][a-z0-9-]*/[A-Z][A-Za-z0-9]*$"
    },
    "EventName": {
      "anyOf": [
        { "$ref": "#/$defs/CoreEventName" },
        { "$ref": "#/$defs/VendorEventName" }
      ]
    },
    "CommonRequest": {
      "type": "object",
      "properties": {
        "spec": { "const": "agent-hooks/0.1" },
        "event_id": { "$ref": "#/$defs/Uuid" },
        "hook_event_name": { "$ref": "#/$defs/EventName" },
        "session_id": { "type": "string", "minLength": 1 },
        "timestamp": { "$ref": "#/$defs/Timestamp" },
        "sequence": { "type": "integer", "minimum": 0 },
        "cwd": { "type": "string", "minLength": 1 },
        "transcript_path": { "type": "string", "minLength": 1 },
        "prompt_id": { "type": "string", "minLength": 1 },
        "scratchpad_dir": { "type": "string", "minLength": 1 },
        "permission_mode": { "type": "string", "minLength": 1 },
        "effort": {
          "type": "object",
          "properties": {
            "level": { "enum": ["low", "medium", "high", "xhigh", "max"] }
          },
          "required": ["level"],
          "additionalProperties": false
        },
        "agent_id": { "type": "string", "minLength": 1 },
        "agent_type": { "type": "string", "minLength": 1 },
        "trace": { "$ref": "#/$defs/TraceContext" },
        "content_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "extensions": { "$ref": "#/$defs/Extensions" }
      },
      "required": ["spec", "event_id", "hook_event_name", "session_id", "timestamp", "sequence"],
      "allOf": [
        {
          "not": {
            "anyOf": [
              { "required": ["event_type"] },
              { "required": ["hook_version"] },
              { "required": ["context"] },
              { "required": ["payload"] }
            ]
          }
        }
      ],
      "additionalProperties": true
    },
    "ToolInput": {
      "type": "object",
      "additionalProperties": true
    },
    "Error": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "message": { "type": "string" }
      },
      "required": ["type"],
      "additionalProperties": true
    },
    "Operation": {
      "type": "object",
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "input": {}
      },
      "required": ["kind", "name"],
      "additionalProperties": true
    },
    "requestsByEvent": {
      "SessionStart": {
        "allOf": [
          { "$ref": "#/$defs/CommonRequest" },
          {
            "type": "object",
            "properties": {
              "hook_event_name": { "const": "SessionStart" },
              "source": { "enum": ["startup", "resume", "clear", "compact", "fork", "other"] },
              "model": { "type": "string", "minLength": 1 }
            },
            "required": ["source"]
          }
        ]
      },
      "UserPromptSubmit": {
        "allOf": [
          { "$ref": "#/$defs/CommonRequest" },
          {
            "type": "object",
            "properties": {
              "hook_event_name": { "const": "UserPromptSubmit" },
              "prompt": { "type": "string" }
            },
            "required": ["prompt_id", "prompt"]
          }
        ]
      },
      "BeforeModelRequest": {
        "allOf": [
          { "$ref": "#/$defs/CommonRequest" },
          {
            "type": "object",
            "properties": {
              "hook_event_name": { "const": "BeforeModelRequest" },
              "model_request_id": { "type": "string", "minLength": 1 },
              "model": { "type": "string", "minLength": 1 },
              "model_provider": { "type": "string", "minLength": 1 },
              "model_parameters": { "type": "object", "additionalProperties": true },
              "messages": { "type": "array", "items": {} },
              "tools": { "type": "array", "items": {} }
            },
            "required": ["prompt_id", "model_request_id", "model", "messages"]
          }
        ]
      },
      "AfterModelResponse": {
        "allOf": [
          { "$ref": "#/$defs/CommonRequest" },
          {
            "type": "object",
            "properties": {
              "hook_event_name": { "const": "AfterModelResponse" },
              "model_request_id": { "type": "string", "minLength": 1 },
              "model": { "type": "string", "minLength": 1 },
              "model_provider": { "type": "string", "minLength": 1 },
              "outcome": { "enum": ["success", "failure", "interrupted"] },
              "response": {
                "type": "object",
                "properties": {
                  "content": {},
                  "tool_calls": { "type": "array", "items": {} },
                  "finish_reason": { "type": "string" }
                },
                "additionalProperties": true
              },
              "error": { "$ref": "#/$defs/Error" },
              "usage": {
                "type": "object",
                "properties": {
                  "input_tokens": { "type": "integer", "minimum": 0 },
                  "output_tokens": { "type": "integer", "minimum": 0 }
                },
                "additionalProperties": true
              }
            },
            "required": ["prompt_id", "model_request_id", "model", "outcome"],
            "allOf": [
              {
                "if": {
                  "properties": { "outcome": { "const": "success" } },
                  "required": ["outcome"]
                },
                "then": {
                  "required": ["response"],
                  "not": { "required": ["error"] }
                },
                "else": {
                  "required": ["error"],
                  "not": { "required": ["response"] }
                }
              }
            ]
          }
        ]
      },
      "PreToolUse": {
        "allOf": [
          { "$ref": "#/$defs/CommonRequest" },
          {
            "type": "object",
            "properties": {
              "hook_event_name": { "const": "PreToolUse" },
              "tool_name": { "type": "string", "minLength": 1 },
              "tool_input": { "$ref": "#/$defs/ToolInput" },
              "tool_use_id": { "type": "string", "minLength": 1 }
            },
            "required": ["prompt_id", "tool_name", "tool_input", "tool_use_id"]
          }
        ]
      },
      "PermissionRequest": {
        "allOf": [
          { "$ref": "#/$defs/CommonRequest" },
          {
            "type": "object",
            "properties": {
              "hook_event_name": { "const": "PermissionRequest" },
              "permission_request_id": { "type": "string", "minLength": 1 },
              "operation_id": { "type": "string", "minLength": 1 },
              "operation": { "$ref": "#/$defs/Operation" },
              "tool_name": { "type": "string", "minLength": 1 },
              "tool_input": { "$ref": "#/$defs/ToolInput" },
              "permission_suggestions": { "type": "array", "items": {} }
            },
            "required": ["prompt_id", "permission_request_id", "operation_id", "operation"]
          }
        ]
      },
      "PermissionDenied": {
        "allOf": [
          { "$ref": "#/$defs/CommonRequest" },
          {
            "type": "object",
            "properties": {
              "hook_event_name": { "const": "PermissionDenied" },
              "permission_request_id": { "type": "string", "minLength": 1 },
              "operation_id": { "type": "string", "minLength": 1 },
              "operation": { "$ref": "#/$defs/Operation" },
              "tool_name": { "type": "string", "minLength": 1 },
              "tool_input": { "$ref": "#/$defs/ToolInput" },
              "tool_use_id": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 },
              "denied_by": { "enum": ["user", "policy", "handler", "host"] }
            },
            "required": ["prompt_id", "permission_request_id", "operation_id", "reason", "denied_by"]
          }
        ]
      },
      "PostToolUse": {
        "allOf": [
          { "$ref": "#/$defs/CommonRequest" },
          {
            "type": "object",
            "properties": {
              "hook_event_name": { "const": "PostToolUse" },
              "tool_name": { "type": "string", "minLength": 1 },
              "tool_input": { "$ref": "#/$defs/ToolInput" },
              "tool_response": { "type": "object", "additionalProperties": true },
              "tool_use_id": { "type": "string", "minLength": 1 },
              "duration_ms": { "type": "number", "minimum": 0 }
            },
            "required": ["prompt_id", "tool_name", "tool_input", "tool_response", "tool_use_id"]
          }
        ]
      },
      "PostToolUseFailure": {
        "allOf": [
          { "$ref": "#/$defs/CommonRequest" },
          {
            "type": "object",
            "properties": {
              "hook_event_name": { "const": "PostToolUseFailure" },
              "tool_name": { "type": "string", "minLength": 1 },
              "tool_input": { "$ref": "#/$defs/ToolInput" },
              "tool_use_id": { "type": "string", "minLength": 1 },
              "error": { "$ref": "#/$defs/Error" },
              "is_interrupt": { "type": "boolean" },
              "duration_ms": { "type": "number", "minimum": 0 }
            },
            "required": ["prompt_id", "tool_name", "tool_input", "tool_use_id", "error"]
          }
        ]
      },
      "SubagentStart": {
        "allOf": [
          { "$ref": "#/$defs/CommonRequest" },
          {
            "type": "object",
            "properties": {
              "hook_event_name": { "const": "SubagentStart" },
              "delegation_id": { "type": "string", "minLength": 1 },
              "agent_id": { "type": "string", "minLength": 1 },
              "agent_type": { "type": "string", "minLength": 1 },
              "parent_agent_id": { "type": "string", "minLength": 1 }
            },
            "required": ["prompt_id", "delegation_id", "agent_id", "agent_type", "parent_agent_id"]
          }
        ]
      },
      "SubagentStop": {
        "allOf": [
          { "$ref": "#/$defs/CommonRequest" },
          {
            "type": "object",
            "properties": {
              "hook_event_name": { "const": "SubagentStop" },
              "delegation_id": { "type": "string", "minLength": 1 },
              "agent_id": { "type": "string", "minLength": 1 },
              "agent_type": { "type": "string", "minLength": 1 },
              "outcome": { "enum": ["success", "failure", "cancelled", "interrupted", "other"] },
              "reason": { "type": "string" }
            },
            "required": ["prompt_id", "delegation_id", "agent_id", "agent_type", "outcome"]
          }
        ]
      },
      "Stop": {
        "allOf": [
          { "$ref": "#/$defs/CommonRequest" },
          {
            "type": "object",
            "properties": {
              "hook_event_name": { "const": "Stop" },
              "outcome": { "enum": ["success", "failure", "cancelled", "interrupted", "other"] },
              "reason": { "type": "string" }
            },
            "required": ["prompt_id", "outcome"]
          }
        ]
      },
      "SessionEnd": {
        "allOf": [
          { "$ref": "#/$defs/CommonRequest" },
          {
            "type": "object",
            "properties": {
              "hook_event_name": { "const": "SessionEnd" },
              "reason": { "enum": ["clear", "resume", "logout", "prompt_input_exit", "exit", "error", "other"] }
            },
            "required": ["reason"]
          }
        ]
      }
    },
    "VendorRequest": {
      "allOf": [
        { "$ref": "#/$defs/CommonRequest" },
        {
          "type": "object",
          "properties": {
            "hook_event_name": { "$ref": "#/$defs/VendorEventName" }
          }
        }
      ],
      "additionalProperties": true
    },
    "HookRequest": {
      "oneOf": [
        { "$ref": "#/$defs/requestsByEvent/SessionStart" },
        { "$ref": "#/$defs/requestsByEvent/UserPromptSubmit" },
        { "$ref": "#/$defs/requestsByEvent/BeforeModelRequest" },
        { "$ref": "#/$defs/requestsByEvent/AfterModelResponse" },
        { "$ref": "#/$defs/requestsByEvent/PreToolUse" },
        { "$ref": "#/$defs/requestsByEvent/PermissionRequest" },
        { "$ref": "#/$defs/requestsByEvent/PermissionDenied" },
        { "$ref": "#/$defs/requestsByEvent/PostToolUse" },
        { "$ref": "#/$defs/requestsByEvent/PostToolUseFailure" },
        { "$ref": "#/$defs/requestsByEvent/SubagentStart" },
        { "$ref": "#/$defs/requestsByEvent/SubagentStop" },
        { "$ref": "#/$defs/requestsByEvent/Stop" },
        { "$ref": "#/$defs/requestsByEvent/SessionEnd" },
        { "$ref": "#/$defs/VendorRequest" }
      ]
    }
  }
}
